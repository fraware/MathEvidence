{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathevidence.org/schemas/analytic-calculus-certificate-v0.json",
  "title": "Analytic calculus certificate (experimental fragment)",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "capability", "source", "derivative", "proof", "claimsCompleteness"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "capability": {
      "const": "analysis.analytic_calculus"
    },
    "capabilityVersion": { "type": "string" },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source": { "type": "object" },
    "derivative": { "type": "object" },
    "proof": { "type": "object" },
    "obligations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "claimsCompleteness": {
      "type": "boolean",
      "const": false
    },
    "solution": { "type": "object" },
    "rhs": { "type": "object" },
    "derivProof": { "type": "object" },
    "initialConditions": {
      "type": "array",
      "items": { "type": "object" }
    },
    "provenance": { "type": "object" }
  }
}
