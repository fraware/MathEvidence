{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathevidence.org/schemas/assurance-policy-v0.json",
  "title": "MathEvidence Assurance Policy (capability-embedded)",
  "description": "Authority for theorem promotion and exact-candidate fail-closed decisions. Adapter discovery fields remain outside this object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "supportedAssuranceModes",
    "exactBinding",
    "replay",
    "certification",
    "maturity",
    "limitations"
  ],
  "properties": {
    "supportedAssuranceModes": {
      "type": "array",
      "items": {
        "enum": ["kernel_replay", "verified_reflection", "native_checked"]
      },
      "uniqueItems": true
    },
    "exactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported"],
      "properties": {
        "supported": { "type": "boolean" },
        "generatorId": { "type": "string", "minLength": 1 },
        "generatorVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "grammarVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "generatorPath": { "type": "string", "minLength": 1 },
        "verifier": { "type": "string", "minLength": 1 },
        "operations": {
          "type": "object",
          "description": "Optional per-operation enablement (e.g. linear algebra).",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["exactBindingSupported", "crEligible"],
            "properties": {
              "exactBindingSupported": { "type": "boolean" },
              "crEligible": { "type": "boolean" }
            }
          }
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "offlineSupported"],
      "properties": {
        "backend": {
          "enum": ["exact_generator", "offline_fixtures", "bridge", "none"]
        },
        "offlineSupported": { "type": "boolean" }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedOutcomes", "crEligible"],
      "properties": {
        "allowedOutcomes": {
          "type": "array",
          "items": {
            "enum": ["proved", "refuted", "evidence_only"]
          },
          "uniqueItems": true
        },
        "crEligible": { "type": "boolean" }
      }
    },
    "maturity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterExists",
        "checkerExists",
        "leanSoundnessExists",
        "bridgeReplayExists",
        "exactCandidateBindingExists",
        "offlineReplayExists"
      ],
      "properties": {
        "adapterExists": { "type": "boolean" },
        "checkerExists": { "type": "boolean" },
        "leanSoundnessExists": { "type": "boolean" },
        "bridgeReplayExists": { "type": "boolean" },
        "exactCandidateBindingExists": { "type": "boolean" },
        "offlineReplayExists": { "type": "boolean" }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
