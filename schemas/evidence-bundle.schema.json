{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathevidence.org/schemas/evidence-bundle-v0.json",
  "title": "MathEvidence Evidence Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundleVersion",
    "capability",
    "requestDigest",
    "claimClass",
    "resultStatus",
    "assuranceMode",
    "files",
    "provenance"
  ],
  "properties": {
    "bundleVersion": {
      "type": "string",
      "enum": ["0.1.0", "0.2.0", "0.3.0"],
      "description": "0.3.0 Candidate Bundle; 0.2.0 canonical .cjson; 0.1.0 legacy pretty .json."
    },
    "artifactKind": {
      "type": "string",
      "enum": ["candidate", "certification"],
      "description": "Required for v0.3; defaults to candidate when absent on legacy manifests."
    },
    "bundleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA256(JCS(manifestBindingPayload)); required for v0.3 Candidate Bundles."
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "claimClass": { "type": "string" },
    "resultStatus": { "type": "string" },
    "assuranceMode": {
      "enum": ["kernel_replay", "verified_reflection", "native_checked"]
    },
    "resourcePolicyDigest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest", "mediaType"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "mediaType": { "type": "string" },
          "role": {
            "type": "string",
            "enum": [
              "request",
              "candidate",
              "certificate",
              "provenance",
              "replay-target",
              "checker-evaluation",
              "theorem-identity",
              "axiom-report",
              "certification-receipt",
              "signature",
              "readme",
              "other"
            ]
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leanVersion", "libraryRevision", "checkerVersion"],
      "properties": {
        "leanVersion": { "type": "string" },
        "libraryRevision": { "type": "string" },
        "checkerVersion": { "type": "string" },
        "backend": {
          "type": ["object", "null"]
        },
        "legacySourcePath": { "type": "string" },
        "legacySourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
