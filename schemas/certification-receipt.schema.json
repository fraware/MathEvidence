{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathevidence.org/schemas/certification-receipt-v0.json",
  "title": "MathEvidence Certification Receipt v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateBundleDigest",
    "certificationRecordDigest",
    "requestDigest",
    "certificateContentDigest",
    "replayTargetDigest",
    "theoremTypeDigest",
    "proofDeclarationDigest",
    "axiomReportDigest",
    "environmentLockDigest",
    "capability",
    "checker",
    "claimRequested",
    "claimEstablished",
    "unresolvedObligations",
    "assuranceMode",
    "resultStatus",
    "toolchain"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["0.3.0"]
    },
    "candidateBundleDigest": { "$ref": "#/$defs/sha256Digest" },
    "certificationRecordDigest": { "$ref": "#/$defs/sha256Digest" },
    "requestDigest": { "$ref": "#/$defs/sha256Digest" },
    "certificateContentDigest": { "$ref": "#/$defs/sha256Digest" },
    "replayTargetDigest": { "$ref": "#/$defs/sha256Digest" },
    "theoremTypeDigest": { "$ref": "#/$defs/sha256Digest" },
    "proofDeclarationDigest": { "$ref": "#/$defs/sha256Digest" },
    "axiomReportDigest": { "$ref": "#/$defs/sha256Digest" },
    "environmentLockDigest": { "$ref": "#/$defs/sha256Digest" },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "module", "name", "version"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "soundnessTheorem": { "type": "string", "minLength": 1 }
      }
    },
    "soundnessTheorem": { "type": "string", "minLength": 1 },
    "claimRequested": { "$ref": "#/$defs/claimClass" },
    "claimEstablished": {
      "anyOf": [{ "$ref": "#/$defs/claimClass" }, { "type": "null" }]
    },
    "unresolvedObligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assuranceMode": {
      "enum": ["kernel_replay", "verified_reflection", "native_checked"]
    },
    "resultStatus": {
      "enum": [
        "computed",
        "tested",
        "checker_accepted",
        "witness_verified",
        "soundness_verified",
        "completeness_verified",
        "optimality_verified",
        "approximation_certified",
        "native_verified",
        "rejected",
        "unsupported",
        "ambiguous"
      ]
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leanVersion", "lakeVersion"],
      "properties": {
        "leanVersion": { "type": "string", "minLength": 1 },
        "lakeVersion": { "type": "string", "minLength": 1 },
        "mathlibVersion": { "type": "string" },
        "platform": { "type": "string" }
      }
    },
    "detail": { "type": "string" }
  },
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "claimClass": {
      "enum": [
        "candidate",
        "witness",
        "refutation",
        "decomposition",
        "soundResult",
        "completeSolution",
        "optimum",
        "enclosure",
        "canonicalForm"
      ]
    }
  }
}
