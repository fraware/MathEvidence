{
  "id": "analysis.analytic_calculus",
  "version": "0.1.0",
  "status": "experimental",
  "lifecycle": "experimental",
  "role": "custom_ir_checker",
  "externalSearchEssential": false,
  "implementationLevel": "mathlib_bridge",
  "adoptionLevel": "none",
  "federationLevel": "none",
  "semanticReview": "absent",
  "trustReview": "absent",
  "domain": "analysis.analytic_calculus",
  "inputIR": {
    "name": "AnalyticExpr",
    "schema": "schemas/analytic-calculus-request.schema.json",
    "version": "0.1.0",
    "baseField": "Real",
    "leanPackage": "MathEvidence.IR.AnalyticExpr"
  },
  "admissibility": {
    "summary": "Experimental Mathlib analytic fragment: DerivProof certificates imply HasDerivAt / HasDerivWithinAt / CandidateSolvesFirstOrderODE under explicit DomainObligation hypotheses. Not a completeness, existence, uniqueness, or solution-family classifier.",
    "rejectedConstructs": [
      "completeness_claims",
      "existence_uniqueness_claims",
      "caller_trusted_domain_booleans",
      "implicit_domain_conditions",
      "branch_cut_claims",
      "approximate_candidates",
      "multivariate_public_fragment"
    ],
    "requiredAssumptions": [
      "typed DomainObligation hypotheses (nonzero / positive / member)",
      "derivation tree reconstructed by Lean",
      "candidate equality proved by Lean, not CAS output"
    ]
  },
  "claimClasses": [
    "candidate",
    "soundResult",
    "witness"
  ],
  "evidenceSchema": "schemas/analytic-calculus-certificate.schema.json",
  "requestSchema": "schemas/analytic-calculus-request.schema.json",
  "checker": {
    "package": "MathEvidence.Checkers.AnalyticCalculus",
    "version": "0.1.0",
    "assurance": "kernel_replay",
    "soundnessStatus": "theorem_stated"
  },
  "assuranceModes": [
    "kernel_replay"
  ],
  "limits": {
    "maxExprNodes": 1024,
    "maxWallTimeMs": 60000,
    "maxOutputBytes": 1048576
  },
  "knownLimitations": [
    "One-variable public fragment only (variable index 0).",
    "No antiderivative-family completeness, ODE existence, ODE uniqueness, or maximal-interval claims.",
    "Backend candidates are proposals only; accepted evidence must use Mathlib analytic predicates.",
    "Lake/Mathlib may be blocked locally; Lean sources are committed for when the toolchain resolves.",
    "Not advertised as Agent compute-live by default; SymPy can propose trees."
  ],
  "conformance": {
    "suite": "MathEvidence/Checkers/AnalyticCalculus",
    "status": "partial",
    "requiredCases": [
      "checkDeriv_product",
      "checkDeriv_domain_obligations",
      "checkDeriv_sound_hasDerivAt",
      "checkODE_residual_ic_propositions"
    ]
  },
  "maintainers": [
    {
      "name": "MathEvidence core",
      "role": "capability_owner",
      "contact": "see SUPPORT.md"
    }
  ],
  "supportClaims": {
    "declared": true,
    "installedHint": "Lean MathEvidence.Checkers.AnalyticCalculus; Python mirror adapters/common/analytic_calculus.py",
    "conformanceVerified": false,
    "backends": ["sympy"]
  },
  "compatibility": {
    "policy": "semver_request_digest",
    "minProtocolVersion": "0.1.0"
  }
}
